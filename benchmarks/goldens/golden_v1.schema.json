{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-anchored golden questions v1",
  "type": "object",
  "required": [
    "schema_version",
    "documents",
    "queries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_uri",
          "text"
        ],
        "properties": {
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "txt",
              "markdown",
              "md",
              "html",
              "htm"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "query",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_uri"
              ],
              "properties": {
                "source_uri": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
